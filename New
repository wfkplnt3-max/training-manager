<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>研修スケジュール管理 - AS部門</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Hiragino Sans',sans-serif;font-size:14px;color:#1a1a1a;background:#f5f5f3}
.app{display:grid;grid-template-columns:190px 1fr 240px;grid-template-rows:auto 1fr;height:100vh;min-height:640px}
.topbar{grid-column:1/-1;display:flex;align-items:center;gap:10px;padding:8px 16px;border-bottom:1px solid #e5e5e0;background:#fff}
.logo{width:28px;height:28px;border-radius:7px;background:#EEEDFE;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.topbar h1{font-size:14px;font-weight:500}
.topbar .sub{font-size:11px;color:#888}
.member-tabs{display:flex;gap:5px;margin-left:auto;flex-wrap:wrap;align-items:center}
.mtab{padding:3px 10px;border-radius:6px;border:1px solid #ddd;background:transparent;cursor:pointer;font-size:11px;color:#666;font-family:inherit}
.mtab:hover{background:#f0f0f0}
.mtab.active{background:#EEEDFE;border-color:#AFA9EC;color:#3C3489}
.add-btn{padding:3px 10px;border-radius:6px;border:1px dashed #ccc;background:transparent;cursor:pointer;font-size:11px;color:#888;font-family:inherit}
.add-btn:hover{background:#f5f5f5}

/* Sidebar Left */
.sidebar-l{padding:12px;border-right:1px solid #e5e5e0;overflow-y:auto;background:#fff;display:flex;flex-direction:column;gap:12px}
.sec-title{font-size:10px;font-weight:600;color:#999;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px}
.minfo{padding:10px;background:#f8f8f6;border-radius:8px}
.mname{font-size:13px;font-weight:500;margin-bottom:3px}
.mmeta{font-size:11px;color:#888;line-height:1.7}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px}
.stat-card{padding:8px 10px;background:#f8f8f6;border-radius:8px}
.stat-card.full{grid-column:1/-1}
.stat-label{font-size:10px;color:#999;margin-bottom:2px}
.stat-val{font-size:18px;font-weight:500;color:#1a1a1a}
.stat-sub{font-size:10px;color:#aaa}
.brow{display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px solid #f0f0f0;font-size:11px}
.brow:last-child{border-bottom:none}
.bbar{height:3px;border-radius:2px;margin-top:3px}

/* Calendar */
.cal-area{padding:12px;overflow:auto;background:#fafaf8;display:flex;flex-direction:column}
.cal-nav{display:flex;align-items:center;gap:7px;margin-bottom:10px;flex-shrink:0}
.ctitle{font-size:13px;font-weight:500}
.vtoggle{display:flex;gap:3px;margin-left:auto}
.vbtn{padding:3px 10px;border-radius:6px;border:1px solid #ddd;background:#fff;cursor:pointer;font-size:11px;color:#666;font-family:inherit}
.vbtn.active{background:#E1F5EE;border-color:#5DCAA5;color:#085041}
.nbtn{padding:3px 9px;border-radius:6px;border:1px solid #ddd;background:#fff;cursor:pointer;font-size:12px;color:#666;font-family:inherit}
.nbtn:hover{background:#f0f0f0}

/* Week grid */
.wgrid{display:grid;grid-template-columns:44px repeat(5,1fr);border:1px solid #e5e5e0;border-radius:8px;overflow:hidden;background:#fff}
.whdr{background:#f8f8f6;padding:6px 4px;text-align:center;font-size:10px;font-weight:500;border-bottom:1px solid #e5e5e0;color:#888}
.whdr.today{color:#185FA5;font-weight:600}
.tlabel{font-size:9px;color:#bbb;padding:0 4px;text-align:right;height:40px;display:flex;align-items:flex-start;padding-top:3px;border-right:1px solid #f0f0f0;background:#fafaf8}
.tcell{height:40px;border-bottom:1px solid #f0f0f0;border-right:1px solid #f0f0f0;position:relative;transition:background .1s}
.tcell:last-child{border-right:none}
.tcell.dov{background:#E1F5EE}
.evchip{position:absolute;left:2px;right:2px;border-radius:4px;padding:2px 5px;font-size:9px;font-weight:500;cursor:grab;overflow:hidden;z-index:2;display:flex;flex-direction:column;justify-content:flex-start}
.evchip:active{cursor:grabbing;opacity:.75}
.evchip .en{font-size:9px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.4}
.evchip .em{font-size:8px;opacity:.8;line-height:1.3}
.evchip .edel{position:absolute;top:2px;right:3px;font-size:9px;cursor:pointer;opacity:0;background:none;border:none;color:inherit;padding:0;line-height:1;font-family:inherit}
.evchip:hover .edel{opacity:.8}
.chip-inp{background:#B5D4F4;color:#0C447C}
.chip-out{background:#C0DD97;color:#27500A}

/* Month grid */
.mgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:#e5e5e0;border-radius:8px;overflow:hidden}
.mdhdr{background:#f8f8f6;text-align:center;font-size:10px;font-weight:500;color:#888;padding:5px}
.mday{background:#fff;min-height:65px;padding:4px;position:relative}
.mday.om{background:#fafaf8;opacity:.5}
.mday.dov{background:#E1F5EE}
.mdnum{font-size:10px;color:#aaa;margin-bottom:2px}
.mev{font-size:9px;padding:1px 4px;border-radius:3px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500}

/* Chip sidebar */
.sidebar-r{padding:12px;border-left:1px solid #e5e5e0;overflow-y:auto;background:#fff}
.chip-search{width:100%;padding:5px 9px;border:1px solid #ddd;border-radius:6px;font-size:11px;background:#fafaf8;color:#1a1a1a;margin-bottom:8px;font-family:inherit;outline:none}
.chip-search:focus{border-color:#AFA9EC;background:#fff}
.cat-hdr{font-size:10px;font-weight:600;margin:10px 0 5px;padding:3px 7px;border-radius:5px;display:flex;align-items:center;gap:5px}
.chip-card{display:flex;align-items:center;gap:6px;padding:6px 8px;border-radius:7px;border:1px solid #ebebeb;margin-bottom:4px;cursor:grab;background:#fff;user-select:none;transition:border-color .1s,box-shadow .1s}
.chip-card:hover{border-color:#ccc;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.chip-card:active{cursor:grabbing;opacity:.7}
.cdot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.cinfo{flex:1;min-width:0}
.cname{font-size:11px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.4}
.csub{font-size:9px;color:#aaa}
.cbadge{font-size:8px;padding:2px 5px;border-radius:4px;flex-shrink:0;font-weight:600}
.cb-i{background:#E6F1FB;color:#185FA5}
.cb-o{background:#EAF3DE;color:#3B6D11}

/* Toast */
.toast{position:fixed;bottom:16px;right:16px;background:#1D9E75;color:#fff;padding:6px 14px;border-radius:8px;font-size:12px;opacity:0;transition:opacity .3s;pointer-events:none;z-index:999;box-shadow:0 2px 8px rgba(0,0,0,.15)}

/* Modal */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000;align-items:center;justify-content:center}
.modal-bg.open{display:flex}
.modal{background:#fff;border-radius:12px;padding:24px;width:360px;box-shadow:0 8px 32px rgba(0,0,0,.15)}
.modal h2{font-size:15px;font-weight:500;margin-bottom:16px}
.modal label{font-size:11px;color:#888;display:block;margin-bottom:4px;margin-top:12px}
.modal input{width:100%;padding:7px 10px;border:1px solid #ddd;border-radius:6px;font-size:13px;font-family:inherit;outline:none}
.modal input:focus{border-color:#AFA9EC}
.modal-btns{display:flex;gap:8px;margin-top:20px;justify-content:flex-end}
.btn-cancel{padding:7px 16px;border-radius:6px;border:1px solid #ddd;background:transparent;cursor:pointer;font-size:12px;font-family:inherit}
.btn-ok{padding:7px 16px;border-radius:6px;border:none;background:#534AB7;color:#fff;cursor:pointer;font-size:12px;font-family:inherit}
.btn-ok:hover{background:#3C3489}
</style>
</head>
<body>

<div class="app">
  <div class="topbar">
    <div class="logo">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <rect x="1" y="1" width="5" height="5" rx="1.2" fill="#534AB7"/>
        <rect x="8" y="1" width="5" height="5" rx="1.2" fill="#534AB7"/>
        <rect x="1" y="8" width="5" height="5" rx="1.2" fill="#534AB7"/>
        <rect x="8" y="8" width="5" height="5" rx="1.2" fill="#AFA9EC"/>
      </svg>
    </div>
    <h1>研修スケジュール管理</h1>
    <span class="sub">AS部門</span>
    <div class="member-tabs" id="memberTabs"></div>
    <button class="add-btn" onclick="openAddMember()">+ 入社者を追加</button>
  </div>

  <div class="sidebar-l">
    <div>
      <div class="sec-title">入社者情報</div>
      <div class="minfo" id="minfo"></div>
    </div>
    <div>
      <div class="sec-title">集計サマリー</div>
      <div id="statBoxes"></div>
    </div>
    <div>
      <div class="sec-title">研修別内訳</div>
      <div id="breakdown"></div>
    </div>
  </div>

  <div class="cal-area">
    <div class="cal-nav">
      <button class="nbtn" id="prevBtn">←</button>
      <span class="ctitle" id="calTitle"></span>
      <button class="nbtn" id="nextBtn">→</button>
      <div class="vtoggle">
        <button class="vbtn active" id="weekBtn" onclick="setView('week')">週</button>
        <button class="vbtn" id="monthBtn" onclick="setView('month')">月</button>
      </div>
    </div>
    <div id="calBody" style="flex:1;overflow:auto"></div>
  </div>

  <div class="sidebar-r">
    <div class="sec-title" style="margin-bottom:6px">研修チップ</div>
    <input class="chip-search" id="chipSearch" placeholder="研修を検索..." oninput="renderChips()">
    <div id="chipList"></div>
  </div>
</div>

<div class="toast" id="toast">保存しました</div>

<!-- Add Member Modal -->
<div class="modal-bg" id="modalBg">
  <div class="modal">
    <h2>入社者を追加</h2>
    <label>氏名</label>
    <input id="inp-name" placeholder="例：田中 次郎" />
    <label>部署</label>
    <input id="inp-dept" value="AS部門" />
    <label>入社日</label>
    <input id="inp-date" type="date" />
    <div class="modal-btns">
      <button class="btn-cancel" onclick="closeModal()">キャンセル</button>
      <button class="btn-ok" onclick="confirmAddMember()">追加</button>
    </div>
  </div>
</div>

<script>
const CHIPS = [
  {id:'s1',name:'チムスピ',cat:'社内勤務',sub:'勤務',type:'inp',mins:60},
  {id:'s2',name:'バクラク',cat:'社内勤務',sub:'勤務',type:'inp',mins:60},
  {id:'s3',name:'スラック',cat:'社内勤務',sub:'勤務',type:'inp',mins:60},
  {id:'s4',name:'部内戦略',cat:'部内',sub:'部内戦略',type:'inp',mins:60},
  {id:'s5',name:'部内変遷',cat:'部内',sub:'部内戦略',type:'inp',mins:60},
  {id:'s6',name:'HS・リテンション解説',cat:'部内',sub:'部内戦略',type:'inp',mins:60},
  {id:'s7',name:'ステークホルダー整理',cat:'部内',sub:'部内戦略',type:'inp',mins:60},
  {id:'s8',name:'フォーカス研修',cat:'部内',sub:'提案活動',type:'out',mins:60},
  {id:'s9',name:'業種別価値・ファクト共有',cat:'部内',sub:'顧客理解',type:'inp',mins:60},
  {id:'s10',name:'DBの使い方',cat:'部内',sub:'日常業務',type:'inp',mins:60},
  {id:'s11',name:'キントーンの使い方',cat:'部内',sub:'日常業務',type:'inp',mins:60},
  {id:'s12',name:'BIの使い方',cat:'部内',sub:'日常業務',type:'inp',mins:60},
  {id:'s13',name:'AS企業一覧スプシ解説',cat:'部内',sub:'日常業務',type:'inp',mins:60},
  {id:'p1',name:'プロダクト体系理解（製品把握）',cat:'スパイダープラス',sub:'プロダクト体系',type:'inp',mins:60},
  {id:'p2',name:'salesサーバー/salesID',cat:'スパイダープラス',sub:'プロダクト体系',type:'inp',mins:60},
  {id:'p3',name:'サポート受電研修',cat:'スパイダープラス',sub:'サポート',type:'out',mins:60},
  {id:'p4',name:'S⁺IDログイン方法',cat:'スパイダープラス',sub:'基本操作',type:'inp',mins:60},
  {id:'p5',name:'標準機能（初級）',cat:'スパイダープラス',sub:'標準機能',type:'out',mins:60},
  {id:'p6',name:'標準機能（上級）',cat:'スパイダープラス',sub:'標準機能',type:'out',mins:60},
  {id:'p7',name:'指摘管理機能',cat:'スパイダープラス',sub:'標準機能',type:'out',mins:60},
  {id:'p8',name:'collabo',cat:'スパイダープラス',sub:'collabo',type:'out',mins:60},
  {id:'p9',name:'Report',cat:'スパイダープラス',sub:'Report',type:'out',mins:60},
  {id:'b1',name:'建築：杭施工記録',cat:'建築パック',sub:'建築パック',type:'out',mins:60},
  {id:'b2',name:'建築：配筋検査',cat:'建築パック',sub:'建築パック',type:'out',mins:60},
  {id:'b3',name:'建築：仕上検査',cat:'建築パック',sub:'建築パック',type:'out',mins:60},
  {id:'b4',name:'建築：進捗管理',cat:'建築パック',sub:'建築パック',type:'out',mins:60},
  {id:'b5',name:'建築：無償ID管理',cat:'建築パック',sub:'建築パック',type:'inp',mins:60},
  {id:'e1',name:'電気：CAD連携',cat:'電気パック',sub:'電気パック',type:'out',mins:60},
  {id:'e2',name:'電気：幹線・負荷設備試験',cat:'電気パック',sub:'電気パック',type:'out',mins:60},
  {id:'e3',name:'電気：コンセント試験',cat:'電気パック',sub:'電気パック',type:'out',mins:60},
  {id:'e4',name:'電気：照度測定',cat:'電気パック',sub:'電気パック',type:'out',mins:60},
  {id:'e5',name:'電気：電力量計確認',cat:'電気パック',sub:'電気パック',type:'out',mins:60},
  {id:'e6',name:'電気：無償ID管理',cat:'電気パック',sub:'電気パック',type:'inp',mins:60},
  {id:'k1',name:'設備：CAD連携',cat:'設備パック',sub:'設備パック',type:'out',mins:60},
  {id:'k2',name:'設備：風量測定',cat:'設備パック',sub:'設備パック',type:'out',mins:60},
  {id:'k3',name:'設備：配管勾配測定',cat:'設備パック',sub:'設備パック',type:'out',mins:60},
  {id:'k4',name:'設備：温湿度計連携',cat:'設備パック',sub:'設備パック',type:'out',mins:60},
  {id:'k5',name:'設備：圧力計連携',cat:'設備パック',sub:'設備パック',type:'out',mins:60},
  {id:'k6',name:'設備：騒音計連携',cat:'設備パック',sub:'設備パック',type:'out',mins:60},
  {id:'k7',name:'設備：無償ID管理',cat:'設備パック',sub:'設備パック',type:'inp',mins:60},
];

const CAT_COLORS = {
  '社内勤務':'#534AB7',
  '部内':'#185FA5',
  'スパイダープラス':'#0F6E56',
  '建築パック':'#BA7517',
  '電気パック':'#993556',
  '設備パック':'#3B6D11',
};

const SK = 'training_sp_v2';

let state = {
  members:[
    {id:'m1',name:'山田 太郎',dept:'AS部門',joinDate:'2025-04-01',events:[]},
    {id:'m2',name:'鈴木 花子',dept:'AS部門',joinDate:'2025-05-12',events:[]},
  ],
  currentMember:'m1',
  view:'week',
  weekOffset:0,
  monthOffset:0,
};

function load(){
  try{
    const d=localStorage.getItem(SK);
    if(d) state=JSON.parse(d);
  }catch(e){}
}

function save(){
  try{
    localStorage.setItem(SK,JSON.stringify(state));
    showToast();
  }catch(e){}
}

function showToast(){
  const t=document.getElementById('toast');
  t.style.opacity='1';
  setTimeout(()=>t.style.opacity='0',1400);
}

function getM(){return state.members.find(m=>m.id===state.currentMember)}

function getWeekDates(){
  const now=new Date();
  now.setDate(now.getDate()+state.weekOffset*7);
  const dow=now.getDay();
  const mon=new Date(now);
  mon.setDate(now.getDate()-(dow===0?6:dow-1));
  return Array.from({length:5},(_,i)=>{const d=new Date(mon);d.setDate(mon.getDate()+i);return d});
}
function fmtD(d){return `${d.getMonth()+1}/${d.getDate()}`}
function fmtFull(d){return d.toISOString().slice(0,10)}
const DAYS=['月','火','水','木','金'];
const HOURS=Array.from({length:10},(_,i)=>i+9);

let dragChip=null,dragEvent=null;

function renderTabs(){
  document.getElementById('memberTabs').innerHTML=
    state.members.map(m=>`<button class="mtab${m.id===state.currentMember?' active':''}" onclick="selectM('${m.id}')">${m.name.split(' ')[0]}</button>`).join('');
}

function selectM(id){state.currentMember=id;renderAll();}

function renderMinfo(){
  const m=getM();
  document.getElementById('minfo').innerHTML=
    `<div class="mname">${m.name}</div><div class="mmeta">${m.dept}<br>${m.joinDate} 入社</div>`;
}

function calcStats(){
  const m=getM();
  const total=m.events.reduce((s,e)=>s+e.mins,0);
  const inp=m.events.filter(e=>e.type==='inp').reduce((s,e)=>s+e.mins,0);
  const out=m.events.filter(e=>e.type==='out').reduce((s,e)=>s+e.mins,0);
  return{total,inp,out};
}

function renderStats(){
  const{total,inp,out}=calcStats();
  const th=Math.round(total/60*10)/10;
  const ih=Math.round(inp/60*10)/10;
  const oh=Math.round(out/60*10)/10;
  document.getElementById('statBoxes').innerHTML=`
    <div class="stat-grid">
      <div class="stat-card full"><div class="stat-label">合計研修時間</div><div class="stat-val">${th}h</div><div class="stat-sub">${total}分</div></div>
      <div class="stat-card"><div class="stat-label">インプット</div><div class="stat-val" style="font-size:15px">${ih}h</div></div>
      <div class="stat-card"><div class="stat-label">アウトプット</div><div class="stat-val" style="font-size:15px">${oh}h</div></div>
    </div>`;
  const m=getM();
  const byChip={};
  m.events.forEach(e=>{
    if(!byChip[e.chipId])byChip[e.chipId]={name:e.name,mins:0,type:e.type,cat:e.cat};
    byChip[e.chipId].mins+=e.mins;
  });
  const rows=Object.values(byChip).sort((a,b)=>b.mins-a.mins).slice(0,8);
  const maxM=rows[0]?.mins||1;
  document.getElementById('breakdown').innerHTML=rows.length===0
    ?'<div style="font-size:11px;color:#aaa;padding:4px 0">まだ配置がありません</div>'
    :rows.map(r=>{
      const col=CAT_COLORS[r.cat]||'#888';
      const w=Math.round(r.mins/maxM*100);
      return `<div class="brow"><div style="flex:1;min-width:0">
        <div style="font-size:11px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${r.name}</div>
        <div class="bbar" style="width:${w}%;background:${col}"></div>
      </div><div style="font-size:10px;color:#aaa;margin-left:6px;flex-shrink:0">${r.mins}分</div></div>`;
    }).join('');
}

function renderChips(){
  const q=(document.getElementById('chipSearch')?.value||'').toLowerCase();
  const cats=[...new Set(CHIPS.map(c=>c.cat))];
  document.getElementById('chipList').innerHTML=cats.map(cat=>{
    const chips=CHIPS.filter(c=>c.cat===cat&&(q===''||c.name.toLowerCase().includes(q)||c.sub.toLowerCase().includes(q)));
    if(!chips.length) return '';
    const col=CAT_COLORS[cat]||'#888';
    return `<div class="cat-hdr" style="background:${col}18;color:${col}">
      <div style="width:7px;height:7px;border-radius:50%;background:${col};flex-shrink:0"></div>${cat}
    </div>`+chips.map(c=>`
      <div class="chip-card" draggable="true" ondragstart="onCD(event,'${c.id}')" ondragend="onDE()">
        <div class="cdot" style="background:${col}"></div>
        <div class="cinfo">
          <div class="cname">${c.name}</div>
          <div class="csub">${c.sub} · ${c.mins}分</div>
        </div>
        <span class="cbadge ${c.type==='inp'?'cb-i':'cb-o'}">${c.type==='inp'?'IN':'OUT'}</span>
      </div>`).join('');
  }).join('');
}

function renderWeek(){
  const dates=getWeekDates();
  document.getElementById('calTitle').textContent=`${fmtD(dates[0])} – ${fmtD(dates[4])} 週`;
  const m=getM();
  let html=`<div class="wgrid"><div class="whdr"></div>`;
  dates.forEach((d,i)=>{
    const isT=fmtFull(d)===fmtFull(new Date());
    html+=`<div class="whdr${isT?' today':''}">${DAYS[i]} ${fmtD(d)}</div>`;
  });
  HOURS.forEach(h=>{
    html+=`<div class="tlabel">${h}:00</div>`;
    dates.forEach(d=>{
      const ds=fmtFull(d);
      const evs=m.events.filter(e=>e.date===ds&&e.hour===h);
      let inner=evs.map(ev=>{
        const hp=Math.max(1,Math.round(ev.mins/60))*40-4;
        return `<div class="evchip ${ev.type==='inp'?'chip-inp':'chip-out'}" style="top:2px;height:${hp}px"
          draggable="true" ondragstart="onED(event,'${ev.id}')" ondragend="onDE()">
          <div class="en">${ev.name}</div>
          <div class="em">${ev.mins}分</div>
          <button class="edel" onclick="delEv('${ev.id}')">✕</button>
        </div>`;
      }).join('');
      html+=`<div class="tcell" ondragover="onDO(event)" ondragleave="onDL(event)" ondrop="onDrop(event,'${ds}',${h})">${inner}</div>`;
    });
  });
  html+='</div>';
  document.getElementById('calBody').innerHTML=html;
}

function renderMonth(){
  const now=new Date();
  now.setMonth(now.getMonth()+state.monthOffset);
  const yr=now.getFullYear(),mo=now.getMonth();
  document.getElementById('calTitle').textContent=`${yr}年${mo+1}月`;
  const m=getM();
  const first=new Date(yr,mo,1);
  const last=new Date(yr,mo+1,0);
  const sdow=first.getDay()===0?6:first.getDay()-1;
  const cells=Math.ceil((sdow+last.getDate())/7)*7;
  let html=`<div class="mgrid">`;
  DAYS.forEach(d=>html+=`<div class="mdhdr">${d}</div>`);
  for(let i=0;i<cells;i++){
    const dn=i-sdow+1;
    const valid=dn>=1&&dn<=last.getDate();
    const d=valid?new Date(yr,mo,dn):null;
    const ds=d?fmtFull(d):'';
    const evs=valid?m.events.filter(e=>e.date===ds):[];
    html+=`<div class="mday${valid?'':' om'}" ondragover="${valid?'onDO(event)':''}" ondragleave="${valid?'onDL(event)':''}" ondrop="${valid?`onDrop(event,'${ds}',9)`:''}">
      ${valid?`<div class="mdnum">${dn}</div>`:''}
      ${evs.map(ev=>`<div class="mev ${ev.type==='inp'?'chip-inp':'chip-out'}">${ev.name}</div>`).join('')}
    </div>`;
  }
  html+='</div>';
  document.getElementById('calBody').innerHTML=html;
}

function renderCal(){
  if(state.view==='week') renderWeek();
  else renderMonth();
}

function setView(v){
  state.view=v;
  document.getElementById('weekBtn').classList.toggle('active',v==='week');
  document.getElementById('monthBtn').classList.toggle('active',v==='month');
  renderCal();
}

document.getElementById('prevBtn').onclick=()=>{
  if(state.view==='week') state.weekOffset--;
  else state.monthOffset--;
  renderCal();
};
document.getElementById('nextBtn').onclick=()=>{
  if(state.view==='week') state.weekOffset++;
  else state.monthOffset++;
  renderCal();
};

function onCD(e,id){dragChip=id;dragEvent=null;e.dataTransfer.effectAllowed='copy';}
function onED(e,id){dragEvent=id;dragChip=null;e.dataTransfer.effectAllowed='move';}
function onDE(){document.querySelectorAll('.dov').forEach(el=>el.classList.remove('dov'));}
function onDO(e){e.preventDefault();e.currentTarget.classList.add('dov');}
function onDL(e){e.currentTarget.classList.remove('dov');}
function onDrop(e,date,hour){
  e.preventDefault();
  e.currentTarget.classList.remove('dov');
  const m=getM();
  if(dragChip){
    const chip=CHIPS.find(c=>c.id===dragChip);
    if(!chip) return;
    m.events.push({id:'e'+Date.now(),chipId:chip.id,name:chip.name,cat:chip.cat,sub:chip.sub,type:chip.type,mins:chip.mins,date,hour});
    save();renderAll();
  } else if(dragEvent){
    const ev=m.events.find(e=>e.id===dragEvent);
    if(ev){ev.date=date;ev.hour=hour;}
    save();renderAll();
  }
  dragChip=null;dragEvent=null;
}

function delEv(id){
  const m=getM();
  m.events=m.events.filter(e=>e.id!==id);
  save();renderAll();
}

function openAddMember(){
  document.getElementById('inp-name').value='';
  document.getElementById('inp-dept').value='AS部門';
  document.getElementById('inp-date').value=new Date().toISOString().slice(0,10);
  document.getElementById('modalBg').classList.add('open');
}
function closeModal(){
  document.getElementById('modalBg').classList.remove('open');
}
function confirmAddMember(){
  const name=document.getElementById('inp-name').value.trim();
  if(!name){alert('氏名を入力してください');return;}
  const dept=document.getElementById('inp-dept').value.trim()||'AS部門';
  const joinDate=document.getElementById('inp-date').value||new Date().toISOString().slice(0,10);
  const id='m'+Date.now();
  state.members.push({id,name,dept,joinDate,events:[]});
  state.currentMember=id;
  closeModal();
  save();renderAll();
}

document.getElementById('modalBg').addEventListener('click',e=>{
  if(e.target===document.getElementById('modalBg')) closeModal();
});

function renderAll(){
  renderTabs();renderMinfo();renderStats();renderChips();renderCal();
}

load();
renderAll();
</script>
</body>
</html>
